# ── URLs ───────────────────────────────────────────────────
# Public URL of this site (used in e-mail links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Game server (NestJS) base URL, reachable from the browser
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4000

# ── Firebase web app config ────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web app → SDK config.
# These values are public by design (they end up in the browser bundle).
# The defaults below work with the local Emulator Suite (`pnpm emulators`).
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-cardroom.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-cardroom
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app

# Local development only — delete this line in production.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
