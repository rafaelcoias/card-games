{
  "name": "@cardroom/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "cards:sync": "node scripts/sync-cards.mjs",
    "og:render": "node scripts/render-og-image.mjs",
    "dev": "pnpm cards:sync && next dev --port 3000",
    "build": "pnpm cards:sync && next build",
    "start": "next start --port ${PORT:-3000}",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cardroom/blackjack": "workspace:*",
    "@cardroom/desconfia": "workspace:*",
    "@cardroom/fodinha": "workspace:*",
    "@cardroom/game-core": "workspace:*",
    "@cardroom/gringo": "workspace:*",
    "@cardroom/high-card": "workspace:*",
    "@cardroom/mexicana": "workspace:*",
    "@cardroom/olho": "workspace:*",
    "@cardroom/peixinho": "workspace:*",
    "@cardroom/shared": "workspace:*",
    "@cardroom/ui": "workspace:*",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "motion": "^12.43.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "vitest": "^3.2.7"
  }
}
