{
  "name": "@cardroom/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative realtime game server (NestJS + Socket.IO + Redis).",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:int": "vitest run --config vitest.int.config.ts",
    "backfill:stats": "tsx scripts/backfill-stats.ts"
  },
  "dependencies": {
    "@cardroom/blackjack": "workspace:*",
    "@cardroom/desconfia": "workspace:*",
    "@cardroom/fodinha": "workspace:*",
    "@cardroom/game-core": "workspace:*",
    "@cardroom/gringo": "workspace:*",
    "@cardroom/high-card": "workspace:*",
    "@cardroom/mexicana": "workspace:*",
    "@cardroom/olho": "workspace:*",
    "@cardroom/peixinho": "workspace:*",
    "@cardroom/shared": "workspace:*",
    "@cardroom/sueca": "workspace:*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/platform-socket.io": "^11.2.6",
    "@nestjs/websockets": "^11.2.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "firebase-admin": "^13.10.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.3",
    "@types/node": "^24.19.0",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.4",
    "vitest": "^3.2.7"
  }
}
