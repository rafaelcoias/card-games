# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated browser origins allowed to connect (the web app URL)
WEB_ORIGIN=http://localhost:3000

# ── Redis (live state of active tables) ───────────────────
REDIS_URL=redis://localhost:6380

# ── Firebase ───────────────────────────────────────────────
# Local development with the Emulator Suite (`pnpm emulators`): no real project needed.
FIREBASE_PROJECT_ID=demo-cardroom
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Production: remove the two *_EMULATOR_HOST lines and paste the service-account key
# (Firebase console → Project settings → Service accounts → Generate new private key),
# either as the raw JSON on one line or base64-encoded.
# FIREBASE_SERVICE_ACCOUNT=

# ── Gameplay ───────────────────────────────────────────────
RECONNECT_GRACE_MS=60000
AWAY_ACTION_DELAY_MS=1200

# ── Voice chat ─────────────────────────────────────────────
# Players connect peer-to-peer through public STUN servers. Some networks need a TURN
# relay (e.g. Cloudflare Realtime TURN, Metered): set its URLs (comma-separated) and credentials.
# VOICE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# VOICE_TURN_USERNAME=
# VOICE_TURN_CREDENTIAL=
